                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              }
            ],
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/destination-assets",
              "host": ["{{partnerBaseUrl}}"],

              "raw": "{\n  \"callbackUrl\": \"https://merchant.example/webhooks/makepay\"\n}"
            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/settings",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "settings"]
            }
          }
        }
      ]
    }
  ]

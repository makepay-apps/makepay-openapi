          "name": "Get bookkeeping summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              }
            ],
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/bookkeeping",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "bookkeeping"]
            }
          }
        },
        {
          "name": "Create invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Invoice #1042\",\n  \"currency\": \"USD\",\n  \"issueDate\": \"2026-05-15\",\n  \"dueDate\": \"2026-05-30\",\n  \"counterparty\": {\n    \"name\": \"Buyer Example\",\n    \"email\": \"buyer@example.com\",\n    \"clientId\": \"crm_123\"\n  },\n  \"lineItems\": [\n    {\n      \"description\": \"Implementation services\",\n      \"quantity\": \"1\",\n      \"unitAmount\": \"500\",\n      \"taxAmount\": \"0\"\n    }\n  ],\n  \"metadata\": {\n    \"orderId\": \"order_1042\"\n  }\n}"
            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/bookkeeping/invoices",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "bookkeeping", "invoices"]
            }
          }
        },
        {
          "name": "Create invoice payment link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",

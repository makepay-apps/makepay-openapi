            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/bookkeeping/invoices/{{invoiceId}}/payment-link",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "bookkeeping", "invoices", "{{invoiceId}}", "payment-link"]

{
  "info": {
    "_postman_id": "735e9154-6f82-4a34-8701-7bfd1c24d7bd",
    "name": "MakePay API",
    "description": "Postman collection for MakePay payment links, checkout, subscriptions, Simple Shop, bookkeeping, branding, and webhook operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is JSON when a body is returned', function () {",
          "  if (pm.response.text()) pm.response.to.be.json;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "partnerBaseUrl",
      "value": "https://www.makecrypto.io"
    },
    {
      "key": "checkoutBaseUrl",
      "value": "https://makepay.io"
    }
  ],
  "item": [
    {
      "name": "Payment Links",
      "item": [
        {
          "name": "Create payment link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"sendPaymentRequestEmail\": false,\n  \"payload\": {\n    \"title\": \"Order #1042\",\n    \"description\": \"Hosted checkout for order #1042\",\n    \"amount\": \"129.99\",\n    \"currency\": \"USDT\",\n    \"orderId\": \"order_1042\",\n    \"customerEmail\": \"buyer@example.com\",\n    \"returnUrl\": \"https://merchant.example/orders/1042\",\n    \"successUrl\": \"https://merchant.example/orders/1042/success\",\n    \"failureUrl\": \"https://merchant.example/orders/1042/pay\",\n    \"metadata\": {\n      \"source\": \"postman\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/payment-links",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "payment-links"]
            },
            "description": "Creates a hosted MakePay checkout link for a merchant order."
          }
        },
        {
          "name": "List payment links",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              }
            ],
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/payment-links?limit=25",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "payment-links"],
              "query": [
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            }
          }
        },
        {
          "name": "Get payment link",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              }
            ],
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/payment-links/{{paymentLinkUid}}",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "payment-links", "{{paymentLinkUid}}"]
            }
          }
        },
        {
          "name": "Pause payment link",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paused\"\n}"
            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/payment-links/{{paymentLinkUid}}",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "payment-links", "{{paymentLinkUid}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Public Checkout",
      "item": [
        {
          "name": "Resolve public payment link",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{checkoutBaseUrl}}/api/public/payment-links/{{paymentLinkUid}}",
              "host": ["{{checkoutBaseUrl}}"],
              "path": ["api", "public", "payment-links", "{{paymentLinkUid}}"]
            }
          }
        },
        {
          "name": "Quote payer asset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellAsset\": \"BTC.BTC\",\n  \"receiptEmail\": \"buyer@example.com\",\n  \"slippage\": 8\n}"
            },
            "url": {
              "raw": "{{checkoutBaseUrl}}/api/public/payment-links/{{paymentLinkUid}}/quote-payin",
              "host": ["{{checkoutBaseUrl}}"],
              "path": ["api", "public", "payment-links", "{{paymentLinkUid}}", "quote-payin"]
            }
          }
        },
        {
          "name": "Start payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": {
              "raw": "{{checkoutBaseUrl}}/api/public/payment-links/{{paymentLinkUid}}/start-payment",
              "host": ["{{checkoutBaseUrl}}"],
              "path": ["api", "public", "payment-links", "{{paymentLinkUid}}", "start-payment"]
            }
          }
        },
        {
          "name": "Get payment status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{checkoutBaseUrl}}/api/public/payment-links/{{paymentLinkUid}}/payment-status?sessionId={{sessionId}}",
              "host": ["{{checkoutBaseUrl}}"],
              "path": ["api", "public", "payment-links", "{{paymentLinkUid}}", "payment-status"],
              "query": [
                {
                  "key": "sessionId",
                  "value": "{{sessionId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Customers and Subscriptions",
      "item": [
        {
          "name": "Upsert customer",
          "request": {
            "method": "POST",
            "header": [

                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@example.com\",\n  \"name\": \"Buyer Example\",\n  \"clientId\": \"crm_123\"\n}"
            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/customers",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "customers"]
            }
          }
        },
        {
          "name": "Create subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountUsd\": \"29\",\n  \"customerEmail\": \"buyer@example.com\",\n  \"label\": \"Monthly plan\",\n  \"billingIntervalUnit\": \"month\",\n  \"billingIntervalCount\": 1\n}"
            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/subscriptions",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "subscriptions"]
            }
          }
        }
      ]
    },
    {
      "name": "Simple Shop",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Digital guide\",\n  \"productType\": \"digital\",\n  \"basePriceUsd\": \"19\",\n  \"shopSlug\": \"digital-guide\",\n  \"images\": [\n    {\n      \"url\": \"https://merchant.example/guide.png\",\n      \"alt\": \"Guide cover\"\n    }\n  ],\n  \"variants\": [\n    {\n      \"name\": \"PDF\",\n      \"priceUsd\": \"19\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/products",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "products"]
            }
          }
        },
        {
          "name": "Update shop",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-MakeCrypto-Key-Id",
                "value": "{{makepayKeyId}}"
              },
              {
                "key": "X-MakeCrypto-Key-Secret",
                "value": "{{makepayKeySecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"merchant-shop\",\n  \"displayCurrency\": \"USD\",\n  \"checkoutMode\": \"hosted\",\n  \"branding\": {\n    \"accentColor\": \"#14b8a6\"\n  }\n}"
            },
            "url": {
              "raw": "{{partnerBaseUrl}}/api/partner/v1/makepay/shop",
              "host": ["{{partnerBaseUrl}}"],
              "path": ["api", "partner", "v1", "makepay", "shop"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookkeeping",
      "item": [
